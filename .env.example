# Local Buzz 757 — environment variables
#
# Copy to `.env.local` and fill in the values for your own Supabase project.
# `.env.local` is gitignored; NEVER commit real keys.
#
# Both variables are read by the browser (NEXT_PUBLIC_*) so only ever use the
# publishable/anon key here — never the service_role or secret key.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# For a local stack (`supabase start`) this is http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable ("anon") key. Safe to expose to the browser; access is
# still enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Scout collector (server-only; never expose these to the browser).
# Keep the service-role key in Vercel/server secrets only.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
SCOUT_MODEL=gpt-4.1-mini
SCOUT_COLLECTOR_SECRET=
SCOUT_COLLECTOR_ENABLED=false
# JSON array of approved official source pages. Example shape:
# [{"id":"venue-specials","placeName":"Example Venue","city":"Norfolk","url":"https://example.com/specials","sourceKind":"website"}]
SCOUT_SOURCE_CATALOG_JSON=[]

